{
  "name": "qq-deepseek-bot",
  "version": "3.1.0",
  "private": true,
  "type": "module",
  "description": "QQ 官方开放平台机器人，接入 DeepSeek",
  "main": "src/index.js",
  "scripts": {
    "setup": "node scripts/bootstrap.js",
    "setup:check": "node scripts/bootstrap.js --check",
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "pm2:start": "pm2 start ecosystem.config.cjs",
    "pm2:restart": "pm2 restart dafeiyu",
    "pm2:stop": "pm2 stop dafeiyu",
    "pm2:delete": "pm2 delete dafeiyu",
    "pm2:logs": "pm2 logs dafeiyu",
    "pm2:status": "pm2 status dafeiyu",
    "check": "node scripts/check-refs.js",
    "dead-code": "node scripts/dead-code.js",
    "diagnose": "node scripts/diagnose.js",
    "version:tag": "node scripts/release.js",
    "test": "node --test \"tests/**/*.test.js\"",
    "test:watch": "node --test --watch \"tests/**/*.test.js\""
  },
  "engines": {
    "node": ">=20.12"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@tencent-connect/qqbot-nodejs": "^1.0.5",
    "cron-parser": "^5.10.3",
    "dotenv": "^18.0.9",
    "exceljs": "^4.4.0",
    "mammoth": "^1.13.0",
    "openai": "^7.45.1",
    "pngjs": "^7.0.0",
    "unpdf": "^2.1.0"
  },
  "devDependencies": {
    "pm2": "^7.1.1"
  },
  "packageManager": "pnpm@12.6.0"
}
