# 复制为 .env 后填写（.env 已被 .gitignore 忽略，不要提交真实密钥）
# 也认旧名：API_KEY / QQBOT_APP_ID / QQBOT_APP_SECRET

# DeepSeek（搜索与抓取共用同一把 key）
DEEP_SEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-flash   # V4.1-Flash，原生支持图片理解；想退回纯文本模型就写 deepseek-chat

# QQ 开放平台 → 机器人管理 → 开发管理
# AppID 是纯数字；AppSecret 是 32 位字符，只显示一次，拿到就存好
QQ_APP_ID=
QQ_APP_SECRET=

# 人格：默认是 src/persona.js 里的「万能大肥鱼」。
# 想换人格直接改 src/persona.js；临时覆盖则取消下面这行注释（单行写完）。
# SYSTEM_PROMPT=你是一个说话干脆的技术顾问，只用中文、纯文本回答，不带表情，不确定就说不确定。

# 可选：对话行为
# HISTORY_TURNS=8
# MAX_INPUT_CHARS=1000
# REPLY_MAX_CHARS=900
# MAX_OUTPUT_TOKENS=8192
# CONTEXT_WINDOW_TOKENS=1000000   # 上下文预算（token），超出后早期对话压成摘要
# CONTEXT_BUDGET_RATIO=0.6
# MARKDOWN_REPLY=false     # 平台已开放自定义 Markdown，打开后回复支持标题/列表/加粗/内嵌图
# QUOTE_REPLY=false        # 引用回复，默认关闭：judge=只在插话时引用 / always=每条都引用
# QUOTE_WINDOW_SECONDS=180 # judge 模式下，这个群 N 秒内我刚说过话就不再引用
# SESSION_TTL_MINUTES=30
# LOG_LEVEL=info

# 可选：语音合成（speak 工具）
# TTS_VOICE=zh-CN-XiaoxiaoNeural   # speak 的默认音色（晓晓）。换活泼少女用 zh-CN-XiaoyiNeural，
#                                  # 男声 zh-CN-YunxiNeural / zh-CN-YunjianNeural，东北话 zh-CN-liaoning-XiaobeiNeural
#                                  # 单次对话里也能让机器人自己换，不用改这里

# 可选：工具（MCP）
# ENABLE_TOOLS=false        # 整个关掉工具，变纯聊天
# GROUP_TOOLS=false         # 只在群里关掉工具
# MAX_TOOL_ROUNDS=100       # 一次对话最多几轮工具调用
# TOOL_TIMEOUT_SECONDS=60   # 单个工具调用超时
# TOOL_CONTENT_LIMIT=4000   # 抓取正文截断长度
# TOOL_DEBUG=false          # 关掉每轮的请求/执行日志
# ADMIN_OPENIDS=                  # 高危工具白名单（shell/run_script/写文件/写技能/装包/加MCP/子任务/定时任务）
                                  # 填你的 openid，逗号分隔；机器人里发 /id 就能查到
# SHELL_GROUP_ENABLED=true       # 没配白名单时，设 true 才会允许群里用高危工具（默认关闭）
# SHELL_UNRESTRICTED=true        # 彻底放开命令黑名单：连读 .env、打印密钥都不拦（非常危险，别在群里开）

# 可选：后台任务（复杂任务交给子助手，边做边汇报）
# TASK_MAX_ROUNDS=20        # 子助手最多执行几步
# TASK_MAX_CONTINUATIONS=3  # 目标没验收通过时最多续跑几轮
# TASK_STALL_SECONDS=300    # 多久没动静算卡住
# TASK_REPORT_INTERVAL=60   # 两次进度汇报的最小间隔（秒）
# TASK_MAX_REPORTS=5        # 单个任务最多汇报几次
# TASK_CONCURRENCY=2        # 同时最多几个工单在跑（2G 内存别超过 2）

# 可选：2C2G 机器的内存上限（不用改，除非你机器更大）
# MAIN_HEAP_MB=320          # 主进程 V8 堆上限
# MCP_HEAP_MB=192           # 内置 MCP 工具服务这个子进程的堆上限
# SHELL_ULIMIT_MB=512       # shell / run_script 每条命令的内存上限
# MAX_SEND_FILE_MB=50       # send_file 单文件上限（要整个读进内存才能上传）
# MAX_RSS=420M              # pm2 整体 RSS 超这个值就重启

# 可选：群聊自动接话（代码默认已是「有问题必回、无冷却」）
# BOT_ALIASES=大肥鱼,鱼鱼,万能大肥鱼   # 提到这些词必回
# GROUP_AUTO_REPLY=false              # 关掉名字触发，只响应 @
# JUDGE_MODE=off                     # 插话判断：off=不判断（默认）/ observe=只记录不回复 / auto=真的接话
#                                    # 旧写法 GROUP_JUDGE=true 等价 JUDGE_MODE=auto
# GROUP_TRIGGER_COOLDOWN=0            # 名字触发冷却（秒），0 = 不限
# JUDGE_COOLDOWN=0                    # 插话后冷却（秒），0 = 不限
# JUDGE_MIN_LENGTH=2                  # 短于此长度不判断
# JUDGE_HOURLY_LIMIT=120              # 每群每小时判断上限
# JUDGE_DEBOUNCE_MS=3000              # 连续消息合并等待
# JUDGE_CONTEXT_SIZE=10               # 判断时看最近几条
# GROUP_LOG_LIMIT=600                 # 每群内存保留条数
# SUMMARY_LIMIT=200                   # /总结 取最近多少条
# SUMMARY_COOLDOWN=0                  # /总结 冷却（秒），0 = 不限
