# 复制为 .env 后填写。只有下面三行是必填的，其余不写就用括号里的默认值。
# .env 已被 .gitignore 忽略，不要提交真实密钥。
# 也认旧名：API_KEY / QQBOT_APP_ID / QQBOT_APP_SECRET

# ============ 必填 ============
# DeepSeek（搜索、抓网页、看图片都用这把 key）
DEEP_SEEK_API_KEY=
# QQ 开放平台 → 机器人管理 → 开发管理
# AppID 是纯数字；AppSecret 是 32 位字符，只显示一次
QQ_APP_ID=
QQ_APP_SECRET=

# ============ 模型 ============
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-flash      # V4.1-Flash，能看图；换纯文本模型写 deepseek-chat，发图会自动降级
# MAX_OUTPUT_TOKENS=8192             # 单次回复的 token 上限
# CONTEXT_WINDOW_TOKENS=128000       # 模型上下文窗口，超预算的早期对话会压成摘要
# CONTEXT_BUDGET_RATIO=0.6           # 只用到窗口的 60%，留余量
# HISTORY_TURNS=8                    # 短期记忆保留最近几轮
# MAX_INPUT_CHARS=1000               # 单条输入上限，超了截断（不拒收）
# REPLY_MAX_CHARS=900                # 单条回复上限，超了自动切段

# ============ 人格 ============
# 默认是 src/persona.js 里的「万能大肥鱼」。想换人格直接改那个文件；
# 临时覆盖就取消下面这行，单行写完。
# SYSTEM_PROMPT=你是一个说话干脆的技术顾问，只用中文、纯文本回答，不确定就说不确定。

# ============ 工具与权限 ============
# ENABLE_TOOLS=false             # 整个关掉工具，变纯聊天
# GROUP_TOOLS=false              # 只在群里关掉工具
# MAX_TOOL_ROUNDS=12             # 一轮对话最多调几轮工具（别设太大，2G 机器扛不住）
# TOOL_TIMEOUT_SECONDS=60        # 单个工具调用超时
# TOOL_CONTENT_LIMIT=4000        # 抓网页正文的截断长度
# TOOL_DEBUG=false               # 详细日志（每轮请求、每次工具调用参数和结果）。排查时设 true
# ADMIN_OPENIDS=                 # 高危工具白名单：shell/run_script/写文件/写技能/装包/加MCP/子任务/定时任务
                                 # 填 openid，逗号分隔；机器人里发 /id 就能查到
# SHELL_GROUP_ENABLED=false      # 白名单为空时，设 true 才允许群里用高危工具（默认关，别乱开）
# SHELL_UNRESTRICTED=false       # 放开命令黑名单：连读 .env、打印密钥都不拦（非常危险）

# ============ 群聊行为 ============
# BOT_ALIASES=大肥鱼,鱼鱼,万能大肥鱼   # 提到这些词必回
# GROUP_AUTO_REPLY=true          # false = 只响应 @，名字触发关掉
# GROUP_TRIGGER_COOLDOWN=0       # 名字触发冷却（秒），0 = 不限
# JUDGE_MODE=off                 # 群消息自动判断：off=不判断（默认）｜observe=只记录不回复｜auto=真的接话
                                  # 旧写法 GROUP_JUDGE=true 等价 JUDGE_MODE=auto（仍兼容）
# JUDGE_COOLDOWN=0               # auto 模式下两次插话的最小间隔（秒）。觉得吵就设 90~300
# JUDGE_MIN_LENGTH=2             # 短于此长度不判断
# JUDGE_HOURLY_LIMIT=60          # 每群每小时最多判断几次
# JUDGE_DEBOUNCE_MS=3000         # 连续消息合并等待
# JUDGE_MAX_WAIT_MS=10000        # 最多等多久就开始判断
# JUDGE_CONTEXT_SIZE=10          # 判断时看最近几条
# GROUP_LOG_LIMIT=600            # 每群内存里保留多少条记录
# SUMMARY_LIMIT=200              # /总结 取最近多少条
# SUMMARY_COOLDOWN=0             # /总结 冷却（秒），0 = 不限
# MERGE_WINDOW_MS=2500           # 连发合并基础窗口：短句自动延到 1.6 倍，完整句子 0.8 秒就回；0 = 逐条处理
# STREAM_REPLY=false             # 私聊流式（默认关）。需要开放平台先开通 /stream_messages 权限，没开通会一直失败
# QUOTE_REPLY=false              # 引用回复：judge=只在插话时引用｜always=每条都引用
# QUOTE_WINDOW_SECONDS=180       # judge 模式下，刚聊过就不再引用

# ============ 主动开口（不配也能跑，但看这里知道默认开什么） ============
# PROACTIVE_ENABLED=true         # 主动接话：每 5 分钟翻群记录，找「有人问但没人答」的问题（默认开）
# PROACTIVE_INTERVAL_MINUTES=5
# PROACTIVE_MAX_PER_HOUR=2       # 每群每小时最多主动几次
# PROACTIVE_COOLDOWN_MINUTES=20  # 两次主动之间的最小间隔
# PROACTIVE_QUIET_START=23       # 静默起点（点）
# PROACTIVE_QUIET_END=8          # 静默终点（点）

# FOLLOWUP_ENABLED=true          # 情绪回访：记下「谁在为什么事发愁」，隔几小时问一句（默认开）
# FOLLOWUP_INTERVAL_MINUTES=60
# FOLLOWUP_MIN_AGE_HOURS=6       # 至少隔多久才提
# FOLLOWUP_QUIET_START=23
# FOLLOWUP_QUIET_END=8

# HOT_TAKE_ENABLED=false         # 热点吐槽：搜当天科技新闻在群里损两句（默认关）
# HOT_TAKE_CRON=0 12,20 * * *    # 什么时候吐槽
# HOT_TAKE_TARGET=               # 指定群号，留空自动挑最近活跃的群

# ============ 后台任务（复杂任务交给子助手，边做边汇报） ============
# TASK_MAX_ROUNDS=20             # 子助手最多执行几步
# TASK_MAX_CONTINUATIONS=3       # 验收没通过时最多续跑几轮，0 = 不续跑
# TASK_STALL_SECONDS=300         # 多久没动静算卡住
# TASK_REPORT_INTERVAL=60        # 两次进度汇报的最小间隔（秒）
# TASK_MAX_REPORTS=3             # 单个任务最多汇报几次（群里固定最多 2 次）
# TASK_CONCURRENCY=2             # 同时最多几个工单（2G 内存别超过 2）
# PROGRESS_INTERVAL=25           # 私聊多少秒报一次进度（群里固定 45 秒一次、一轮最多一条）
# PROGRESS_MAX=3                 # 私聊一轮最多报几次进度

# ============ 杂项 ============
# SESSION_TTL_MINUTES=30         # 会话闲置这么久清空短期/中期记忆（长期事实保留）
# MEDIA_TTL_HOURS=24             # downloads/incoming 里的附件留多少小时
# TTS_VOICE=zh-CN-XiaoxiaoNeural # speak 的默认音色（晓晓）。活泼少女 zh-CN-XiaoyiNeural，
                                  # 男声 zh-CN-YunxiNeural / zh-CN-YunjianNeural，东北话 zh-CN-liaoning-XiaobeiNeural
# MARKDOWN_REPLY=false           # 平台开放 Markdown 后打开：支持标题/列表/加粗/内嵌图
# LOG_LEVEL=info
# BACKUP_KEEP=7
# BACKUP_KEEP=7                  # data/ 和 skills/ 的每日备份保留几份（在 backups/ 下）
# YTDLP_IMPERSONATE=chrome        # 视频站点按 TLS 指纹拦爬虫时用它伪装浏览器（需先 pip3 install curl_cffi）

# ============ 2C2G 机器的内存上限（机器更大再调） ============
# MAIN_HEAP_MB=320               # 主进程 V8 堆上限
# MCP_HEAP_MB=160                # 内置 MCP 工具服务子进程的堆上限
# SHELL_ULIMIT_MB=512            # shell / run_script 每条命令的内存上限
# MAX_SEND_FILE_MB=50            # send_file 单文件上限（要整个读进内存才能上传）
# MAX_RSS=420M                   # pm2 整体 RSS 超这个值就重启
# AUTO_SYNC_ON_EXIT=true         # 退出前自动 git commit + push（「自己进化」靠它）
# AUTO_SYNC_INTERVAL_MINUTES=30  # 每隔多少分钟自动提交一次；0 = 只靠退出时提交
